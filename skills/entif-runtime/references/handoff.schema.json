{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entif.runtime.handoff/v1",
  "title": "Entif Runtime Handoff v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "handoff_id",
    "kind",
    "created_at",
    "runtime_surface",
    "reason",
    "mission",
    "refs",
    "work",
    "checkpoint",
    "completed",
    "negative_knowledge",
    "unresolved",
    "next_safe_operations",
    "hydration",
    "verification",
    "cleanup"
  ],
  "properties": {
    "schema": {"const": "entif.runtime.handoff/v1"},
    "handoff_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["checkpoint", "transfer", "completion", "emergency"]},
    "created_at": {"type": "string", "minLength": 1},
    "runtime_surface": {"enum": ["chat", "codex", "unknown"]},
    "reason": {"type": "string"},
    "mission": {"type": "string", "minLength": 1},
    "refs": {"type": "object"},
    "work": {"type": "object"},
    "checkpoint": {"type": "object"},
    "completed": {"type": "array", "items": {"type": "string"}},
    "negative_knowledge": {"type": "array", "items": {"type": "string"}},
    "unresolved": {"type": "array", "items": {"type": "object"}},
    "next_safe_operations": {"type": "array", "items": {"type": "string"}},
    "hydration": {
      "type": "object",
      "required": ["read_first", "read_if_needed", "read_if_condition"],
      "properties": {
        "read_first": {"type": "array", "items": {"type": "string"}},
        "read_if_needed": {"type": "array", "items": {"type": "string"}},
        "read_if_condition": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {"type": "array", "items": {"type": "string"}},
    "cleanup": {"type": "object"},
    "source_trace": {"type": ["object", "null"]},
    "akasha_receipt": {"type": ["object", "null"]}
  }
}
